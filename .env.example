# Copy this file to .env and fill in the values. Never commit .env.

ODATA_URL=https://supremebrands.acumatica.com
ODATA_TENANT=Supreme
ODATA_USER=
ODATA_PASSWORD=

# Rows per request. Make it smaller if large inquiries time out.
PAGE_SIZE=5000

# SQLite database file
DB_PATH=data/supreme.db

# Inquiries to skip (comma-separated, exact names), for example:
# SKIP_INQUIRIES=GL-Journal Transactions,SalesDetail
SKIP_INQUIRIES=

# Email domains of Supreme Brands itself (used to find customer records with a company address)
OWN_EMAIL_DOMAINS=supremebrands

# Performance analysis period and main currency
PERIOD_START=2023-07-01
PERIOD_END=2026-09-30
BASE_CURRENCY=USD
